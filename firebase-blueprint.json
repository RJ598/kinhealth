{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile and active household pointer.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "householdId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "householdId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Household": {
      "title": "Household",
      "description": "Personal or shared group space supporting 1 to 10 members for solo tracking and group/partner comparison.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^[A-Z0-9]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberIds": {
          "type": "array",
          "description": "Bounded array of 1 to 10 member UIDs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "inviteCode",
        "ownerId",
        "memberIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "HouseholdInvite": {
      "title": "HouseholdInvite",
      "description": "Direct-lookup invite code mapping to a household without exposing PII.",
      "type": "object",
      "properties": {
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^[A-Z0-9]+$"
        },
        "householdId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "householdName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "inviteCode",
        "householdId",
        "householdName",
        "ownerId",
        "createdAt"
      ]
    },
    "MemberProfile": {
      "title": "MemberProfile",
      "description": "Household partner targets and anthropometrics without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "roleLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "calorieTarget": {
          "type": "number"
        },
        "proteinTargetG": {
          "type": "number"
        },
        "carbsTargetG": {
          "type": "number"
        },
        "fatTargetG": {
          "type": "number"
        },
        "heightCm": {
          "type": "number"
        },
        "targetWeightKg": {
          "type": "number"
        },
        "targetMuscleMassKg": {
          "type": "number"
        },
        "sharedUids": {
          "type": "array",
          "description": "Bounded array of 1 to 10 household member UIDs."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "roleLabel",
        "calorieTarget",
        "proteinTargetG",
        "carbsTargetG",
        "fatTargetG",
        "heightCm",
        "targetWeightKg",
        "targetMuscleMassKg",
        "sharedUids",
        "updatedAt"
      ]
    },
    "FoodLog": {
      "title": "FoodLog",
      "description": "Individual meal or food entry with calories, macros, and optional AI photo analysis summary.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "mealType": {
          "type": "string",
          "enum": ["breakfast", "lunch", "dinner", "snack"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "servingNote": {
          "type": "string",
          "maxLength": 120
        },
        "calories": {
          "type": "number"
        },
        "proteinG": {
          "type": "number"
        },
        "carbsG": {
          "type": "number"
        },
        "fatG": {
          "type": "number"
        },
        "fiberG": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "enum": ["ai_photo", "manual", "preset"]
        },
        "aiConfidence": {
          "type": "string",
          "enum": ["", "high", "medium", "low"]
        },
        "aiItemsSummary": {
          "type": "string",
          "maxLength": 500
        },
        "sharedUids": {
          "type": "array",
          "description": "Bounded array of 1 to 10 member UIDs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "authorName",
        "date",
        "mealType",
        "name",
        "servingNote",
        "calories",
        "proteinG",
        "carbsG",
        "fatG",
        "fiberG",
        "source",
        "aiConfidence",
        "aiItemsSummary",
        "sharedUids",
        "createdAt",
        "updatedAt"
      ]
    },
    "FoodPreset": {
      "title": "FoodPreset",
      "description": "Reusable personal daily food preset with saved calories and macros for one-tap logging.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "mealType": {
          "type": "string",
          "enum": ["breakfast", "lunch", "dinner", "snack"]
        },
        "servingNote": {
          "type": "string",
          "maxLength": 120
        },
        "calories": {
          "type": "number"
        },
        "proteinG": {
          "type": "number"
        },
        "carbsG": {
          "type": "number"
        },
        "fatG": {
          "type": "number"
        },
        "fiberG": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "name",
        "mealType",
        "servingNote",
        "calories",
        "proteinG",
        "carbsG",
        "fatG",
        "fiberG",
        "createdAt",
        "updatedAt"
      ]
    },
    "BodyLog": {
      "title": "BodyLog",
      "description": "Body composition check-in recording weight, skeletal muscle mass, body fat percentage, and computed indexes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "weightKg": {
          "type": "number"
        },
        "muscleMassKg": {
          "type": "number"
        },
        "bodyFatPct": {
          "type": "number"
        },
        "visceralFatIndex": {
          "type": "number"
        },
        "waistCm": {
          "type": "number"
        },
        "bmi": {
          "type": "number"
        },
        "smi": {
          "type": "number"
        },
        "ffmi": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "sharedUids": {
          "type": "array",
          "description": "Bounded array of 1 to 10 member UIDs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "authorName",
        "date",
        "weightKg",
        "muscleMassKg",
        "bodyFatPct",
        "visceralFatIndex",
        "waistCm",
        "bmi",
        "smi",
        "ffmi",
        "notes",
        "sharedUids",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile containing email PII and household link."
    },
    "/users/{userId}/foodPresets/{presetId}": {
      "schema": { "$ref": "#/entities/FoodPreset" },
      "description": "Personal saved daily food presets for one-tap meal logging."
    },
    "/households/{householdId}": {
      "schema": { "$ref": "#/entities/Household" },
      "description": "Personal or shared group workspace supporting 1 to 10 members."
    },
    "/householdInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/HouseholdInvite" },
      "description": "Invite code lookup table for joining a household."
    },
    "/households/{householdId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/MemberProfile" },
      "description": "Member nutrition targets, height, and goal weights inside a workspace."
    },
    "/households/{householdId}/foodLogs/{logId}": {
      "schema": { "$ref": "#/entities/FoodLog" },
      "description": "Food intake logs belonging to members of the workspace."
    },
    "/households/{householdId}/bodyLogs/{logId}": {
      "schema": { "$ref": "#/entities/BodyLog" },
      "description": "Weight, muscle mass, and body index logs belonging to members of the workspace."
    }
  }
}
